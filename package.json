{
  "name": "ruangcatat-mini",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catatan konseling fiktif: JavaScript murni dan Tailwind lokal",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-site.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
